# Copy to .env. Every value is optional.

# OpenRouteService key (free at https://openrouteservice.org). Without it, the public OSRM server is used.
ORS_API_KEY=

# Max distance in miles a station may be from the route (default 10).
CORRIDOR_MILES=10

# The first stop is the cheapest station within this many miles of the start (default 50, max 50).
FIRST_STOP_WINDOW_MILES=50
